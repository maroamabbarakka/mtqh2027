# Firebase client config bersifat publik menurut model Firebase, tetapi nilai proyek tetap per lingkungan.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
VITE_WORKER_API_URL=
# URL publik Worker (tanpa trailing slash), bukan service-account secret.

# Jangan pernah meletakkan service account, private key, atau Cloudinary secret di VITE_*.
# Storage Bucket sengaja tidak dikonfigurasi: proyek wajib Spark-only tanpa Cloud Storage.
